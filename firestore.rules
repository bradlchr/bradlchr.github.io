rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        ('role' in request.auth.token && request.auth.token.role == 'admin') ||
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isAdvisor() {
      return isAuthenticated() && (
        isAdmin() ||
        ('role' in request.auth.token && request.auth.token.role in ['advisor', 'user']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['advisor', 'user', 'admin'])
      );
    }

    function isReportOwner(reportData) {
      return isAuthenticated() && (
        ('owner_uid' in reportData && reportData.owner_uid == request.auth.uid) ||
        ('advisor_id' in reportData && reportData.advisor_id == request.auth.uid) ||
        ('advisor_email' in reportData && request.auth.token.email != null && reportData.advisor_email == request.auth.token.email)
      );
    }

    function isUserPathOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == userId)
      );
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isValidPlant(data) {
      return data.keys().hasAll(['scientific_name']) &&
        data.keys().hasOnly([
          'id', 'scientific_name', 'common_names', 'native_environment', 'plant_type',
          'architectural_layer', 'mature_height', 'mature_height_min', 'mature_height_max',
          'height_display', 'bloom_color', 'bloom_period', 'soil_requirements',
          'moisture_requirements', 'light_requirements', 'wildlife_ecosystem_benefits',
          'wildlife_ecological_value', 'wildlife_detail', 'sociability', 'maintenance_level',
          'maintenance_guide', 'advisor_description', 'human_health_use', 'plant_url',
          'plantfinder_url', 'is_sweet16', 'is_sweet_16', 'is_kc_keystone', 'isKcKeystone',
          'special_tags', 'images', 'sources', 'locked_by_user_id', 'locked_by_user_name',
          'locked_by_user_email', 'locked_at', 'lock_expires_at', 'last_edited_by_user_id',
          'last_edited_by_user_name', 'last_edited_by_user_email', 'last_edited_timestamp',
          'created_at', 'created_by', 'updated_at', 'updated_by', 'metadata', 'updated_at_ms', 'raw_desc'
        ]) &&
        data.scientific_name is string && data.scientific_name.size() > 0 && data.scientific_name.size() <= 150 &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('common_names' in data) || (data.common_names is list && data.common_names.size() <= 25)) &&
        (!('images' in data) || (data.images is list && data.images.size() <= 30)) &&
        (!('sources' in data) || (data.sources is list && data.sources.size() <= 30)) &&
        (!('advisor_description' in data) || (data.advisor_description is string && data.advisor_description.size() <= 5000)) &&
        (!('wildlife_ecological_value' in data) || (data.wildlife_ecological_value is string && data.wildlife_ecological_value.size() <= 5000)) &&
        (!('human_health_use' in data) || (data.human_health_use is string && data.human_health_use.size() <= 5000));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'role']) &&
        data.keys().hasOnly([
          'id', 'uid', 'username', 'first_name', 'last_name', 'name', 'email',
          'phone_number', 'advisor_type', 'role', 'password_hash', 'salt',
          'is_temporary_password', 'avatar_url', 'text_size', 'created_at', 'updated_at'
        ]) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.email is string && data.email.size() <= 150 &&
        data.role is string && data.role in ['admin', 'user', 'advisor'] &&
        (!('username' in data) || (data.username is string && data.username.size() > 0 && data.username.size() <= 64)) &&
        (!('name' in data) || (data.name is string && data.name.size() <= 150));
    }

    function isValidReport(data) {
      return data.keys().hasAll(['client_name']) &&
        data.keys().hasOnly([
          'id', 'owner_uid', 'username', 'advisor_id', 'advisor_name', 'advisor_email',
          'client_name', 'client_address', 'project_name', 'consultation_date',
          'site_summary', 'summary_notes', 'drive_doc_url', 'last_modified',
          'is_drive_synced', 'garden_areas', 'garden_area_profiles', 'planner_workflow',
          'staged_recommendations', 'staged_plants', 'staged_invasives', 'report_options',
          'created_at', 'updated_at'
        ]) &&
        data.client_name is string && data.client_name.size() > 0 && data.client_name.size() <= 150 &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('site_summary' in data) || (data.site_summary is string && data.site_summary.size() <= 10000)) &&
        (!('summary_notes' in data) || (data.summary_notes is string && data.summary_notes.size() <= 10000)) &&
        (!('staged_recommendations' in data) || (data.staged_recommendations is list && data.staged_recommendations.size() <= 200)) &&
        (!('staged_plants' in data) || (data.staged_plants is list && data.staged_plants.size() <= 200)) &&
        (!('staged_invasives' in data) || (data.staged_invasives is list && data.staged_invasives.size() <= 100));
    }

    function isValidApproval(data) {
      return data.keys().hasAll(['id', 'status', 'type', 'scientific_name']) &&
        data.keys().hasOnly([
          'id', 'status', 'type', 'scientific_name', 'common_name', 'plant_id',
          'submitted_by_id', 'submitted_by_name', 'submitted_by_email', 'submitted_at',
          'reviewed_by_id', 'reviewed_by_name', 'reviewed_at', 'raw_json'
        ]) &&
        data.id is string && data.id.size() <= 128 &&
        data.status is string && data.status in ['pending', 'approved', 'denied'] &&
        data.type is string && data.type in ['edit', 'add', 'new_plant'] &&
        data.scientific_name is string && data.scientific_name.size() <= 150 &&
        (!('raw_json' in data) || (data.raw_json is string && data.raw_json.size() <= 50000));
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /plants/{plantId} {
      allow read: if true;
      allow create: if isAdmin() && !plantId.matches('^_.*') && isValidPlant(request.resource.data) && (!('id' in request.resource.data) || request.resource.data.id == plantId);
      allow update: if isAdmin() && !plantId.matches('^_.*') && isValidPlant(request.resource.data) && areImmutableFieldsUnchanged(['id']);
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || isUserPathOwner(userId);
      allow create: if (isAdmin() || (isAuthenticated() && request.auth.uid == userId && request.resource.data.role in ['user', 'advisor'])) && isValidUser(request.resource.data);
      allow update: if (isAdmin() || (isUserPathOwner(userId) && areImmutableFieldsUnchanged(['id', 'username', 'role']))) && isValidUser(request.resource.data) && areImmutableFieldsUnchanged(['id', 'username']);
      allow delete: if isAdmin();

      match /reports/{reportId} {
        allow read: if isAdmin() || isUserPathOwner(userId) || isReportOwner(resource.data);
        allow create: if isAuthenticated() && (isAdmin() || isUserPathOwner(userId) || isReportOwner(request.resource.data)) && isValidReport(request.resource.data);
        allow update: if isAuthenticated() && (isAdmin() || ((isUserPathOwner(userId) || isReportOwner(resource.data)) && isReportOwner(request.resource.data))) && isValidReport(request.resource.data) && areImmutableFieldsUnchanged(['id']);
        allow delete: if isAdmin() || isUserPathOwner(userId) || isReportOwner(resource.data);
      }
    }

    match /reports/{reportId} {
      allow read: if isAdmin() || isReportOwner(resource.data);
      allow create: if isAuthenticated() && (isAdmin() || isReportOwner(request.resource.data)) && isValidReport(request.resource.data);
      allow update: if isAuthenticated() && (isAdmin() || (isReportOwner(resource.data) && isReportOwner(request.resource.data))) && isValidReport(request.resource.data) && areImmutableFieldsUnchanged(['id']);
      allow delete: if isAdmin() || isReportOwner(resource.data);
    }

    match /plant_approvals/{approvalId} {
      allow read: if isAuthenticated();
      allow create: if isAdvisor() && request.resource.data.status == 'pending' && isValidApproval(request.resource.data);
      allow update: if isAdmin() && isValidApproval(request.resource.data) && areImmutableFieldsUnchanged(['id']);
      allow delete: if isAdmin();
    }
  }
}
